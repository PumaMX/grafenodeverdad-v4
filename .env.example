# Canonical URL used in metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://example.com

# Public inbox used by the contact flow.
NEXT_PUBLIC_CONTACT_EMAIL=contacto@example.com

# Public Sanity identifiers used by the editor and content API.
NEXT_PUBLIC_SANITY_PROJECT_ID=5sm3bwwz
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_STUDIO_URL=/studio

# Server-only Viewer token used for draft previews. Never prefix it with NEXT_PUBLIC_.
SANITY_API_READ_TOKEN=
